{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/pay/:path*", "destination": "/customer/:path*" },
    { "source": "/pay", "destination": "/customer/index.html" },
    { "source": "/receive/:path*", "destination": "/merchant/:path*" },
    { "source": "/receive", "destination": "/merchant/index.html" },
    { "source": "/shared/:path*", "destination": "/shared/:path*" },
    { "source": "/", "destination": "/customer/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}

